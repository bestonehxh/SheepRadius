FROM debian:13-slim

ENV DEBIAN_FRONTEND=noninteractive

# Debian 13 packaging traps, all of them learned the hard way:
#   * /usr/sbin/samba (the AD DC daemon) is NOT in `samba` — it is in `samba-ad-dc`,
#     which is only a Recommends, so --no-install-recommends silently drops it.
#   * the AD schema LDIFs are in `samba-ad-provision`; without it a provision dies with
#     AD_DS_Attributes_Windows_Server_v1903.ldf not found.
#   * ldb-tools gives ldbsearch/ldbmodify, which is how the app reads and writes
#     attributes samba-tool has no flag for.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        samba samba-ad-dc samba-common-bin samba-ad-provision samba-dsdb-modules samba-vfs-modules \
        winbind libnss-winbind libpam-winbind \
        krb5-user krb5-config \
        ldap-utils dnsutils smbclient \
        python3-samba \
        acl attr iproute2 iputils-ping procps netcat-openbsd ca-certificates \
        tdb-tools ldb-tools && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Samba AD DC and the SMB/NMB services must not be managed by systemd here.
RUN rm -f /etc/samba/smb.conf

COPY entrypoint.sh /usr/local/sbin/entrypoint.sh
COPY fix-dns.sh    /usr/local/sbin/fix-dns.sh
RUN chmod +x /usr/local/sbin/entrypoint.sh /usr/local/sbin/fix-dns.sh

# The image's own generation, matching `ADImage.tag` in ADSupport.swift. The app selects an
# image by tag and offers "Rebuild image" when the newest one on this Mac is older than the
# Containerfile this build ships; this label is here so the same answer can be had from
# `container inspect` without the app.
LABEL sheep.ad.image.version="3"

ENV REALM=LAB.SHEEP \
    DOMAIN=LABSHEEP \
    DCNAME=dc1 \
    DNS_FORWARDER=1.1.1.1 \
    REQUIRE_STRONG_AUTH=no \
    RPC_PORT_RANGE=49152-49172

ENTRYPOINT ["/usr/local/sbin/entrypoint.sh"]
